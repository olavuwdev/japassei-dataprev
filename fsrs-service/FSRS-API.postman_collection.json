  },
  "auth": {
    "type": "apiKey",
    "apiKey": [
      {
        "key": "key",
        "value": "X-Internal-Token",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{TOKEN}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Status",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/internal/health",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "internal",
                "health"
              ]
            },
            "description": "Verifica se o serviço está funcionando. Não requer token."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "http://127.0.0.1:3100/internal/health",
                  "protocol": "http",
                  "host": [
                    "127.0.0.1"
                  ],
                  "port": "3100",
                  "path": [
                    "internal",
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"fsrs_version\": \"5.2.1\",\n  \"node_version\": \"v20.0.0\",\n  \"uptime_seconds\": 1234\n}"
            }
          ]
        }
      ]
