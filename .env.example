# Copie este arquivo para .env e configure com seus valores reais

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8077'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = dataprev
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# FLASHCARDS - FSRS Service
#--------------------------------------------------------------------

# URL do serviço FSRS (Node.js)
# Desenvolvimento: http://127.0.0.1:3100
# Produção (Hostinger): https://flashcards.olavoadriel.com.br
FSRS_SERVICE_URL = 'http://127.0.0.1:3100'

# Token compartilhado com o serviço FSRS
# Deve ser definido no painel de Variáveis de Ambiente da Hostinger
FSRS_SERVICE_TOKEN = ''

#--------------------------------------------------------------------
# FLASHCARDS - OpenAI (Geração de Cartões por IA)
#--------------------------------------------------------------------

# Chave de API da OpenAI
# OPENAI_API_KEY = 'sk-...'

# ID do projeto no OpenAI
# OPENAI_PROJECT_ID = '...'

# Modelo GPT para geração de cartões
# OPENAI_MODEL_FLASHCARDS = 'gpt-4.1-mini'

# Modelo fallback se o principal falhar
# OPENAI_MODEL_FLASHCARDS_FALLBACK = 'gpt-4.1-nano'
